diff --git a/components/furi_hal/furi_hal_usb_hid_output_report.h b/components/furi_hal/furi_hal_usb_hid_output_report.h
new file mode 100644
index 0000000..56fb06f
--- /dev/null
+++ b/components/furi_hal/furi_hal_usb_hid_output_report.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define FURI_HAL_USB_HID_KEYBOARD_REPORT_ID 1
+
+/* TinyUSB delivers SET_REPORT with its report ID separately, but calls the
+ * interrupt-OUT endpoint with report_id == 0 and the ID in the payload. */
+static inline bool furi_hal_usb_hid_keyboard_led_report(
+    uint8_t report_id,
+    const uint8_t* buffer,
+    uint16_t length,
+    uint8_t* led_state) {
+    if(!buffer || !led_state) return false;
+
+    if(report_id == 0) {
+        if(length < 2) return false;
+        report_id = *buffer++;
+        --length;
+    }
+
+    if(report_id != FURI_HAL_USB_HID_KEYBOARD_REPORT_ID || length < 1) return false;
+    *led_state = buffer[0];
+    return true;
+}
