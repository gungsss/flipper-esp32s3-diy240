index 0000000..6fe84c5
--- /dev/null
+++ b/components/fw_ota/fw_ota_profile.c
@@ -0,0 +1,32 @@
+#include "fw_ota_profile.h"
+#include <board.h>
+#include <string.h>
+
+_Static_assert(sizeof(FwOtaBoardProfile) == 44, "OTA profile layout changed");
+
+/* The section and forced linker reference give this a stable image offset. */
+const __attribute__((section(".rodata_custom_desc"), used)) FwOtaBoardProfile
+    fw_ota_board_profile = {
+#if defined(BOARD_OTA_PROFILE_ST7735) && BOARD_OTA_PROFILE_ST7735
+        .magic = {'D', 'I', 'Y', 'O', 'T', 'A', '1', 0},
+        .schema = 1,
+        .display_controller = 7735,
+        .pins = {
+            BOARD_PIN_LCD_MOSI, BOARD_PIN_LCD_SCLK, BOARD_PIN_LCD_DC,
+            BOARD_PIN_LCD_RST, BOARD_PIN_LCD_CS, BOARD_PIN_LCD_BL,
+            BOARD_PIN_SD_SCK, BOARD_PIN_SD_MOSI, BOARD_PIN_SD_MISO2,
+            BOARD_PIN_SD_CS, BOARD_PIN_BTN_UP, BOARD_PIN_BTN_DOWN,
+            BOARD_PIN_BTN_LEFT, BOARD_PIN_BTN_RIGHT, BOARD_PIN_BTN_OK,
+            BOARD_PIN_BTN_BACK,
+        },
+#else
+        .magic = {0},
+#endif
+};
+
+bool fw_ota_profile_matches(const void* candidate, size_t length) {
+    static const uint8_t magic[8] = {'D', 'I', 'Y', 'O', 'T', 'A', '1', 0};
+    return candidate && length >= sizeof(fw_ota_board_profile) &&
+           memcmp(fw_ota_board_profile.magic, magic, sizeof(magic)) == 0 &&
+           memcmp(candidate, &fw_ota_board_profile, sizeof(fw_ota_board_profile)) == 0;
+}
