@@ -0,0 +1,17 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Fixed-size board description placed immediately after esp_app_desc_t.
+ * This is a compatibility marker, not a cryptographic signature. */
+typedef struct __attribute__((packed)) {
+    uint8_t magic[8];
+    uint16_t schema;
+    uint16_t display_controller;
+    uint16_t pins[16];
+} FwOtaBoardProfile;
+
+extern const FwOtaBoardProfile fw_ota_board_profile;
+bool fw_ota_profile_matches(const void* candidate, size_t length);
